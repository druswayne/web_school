# Секрет сессий Flask
SECRET_KEY=replace-with-long-random-string

# SQLite (по умолчанию) или PostgreSQL:
# DATABASE_URL=sqlite:///instance/school.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/school_math

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_NAME=Администратор

# Необязательный демо-ученик при первом запуске (все курсы и занятия открыты)
DEMO_SEED=1
DEMO_USERNAME=ivan
DEMO_PASSWORD=ivan123
DEMO_NAME=Иван Петров

# OpenRouter / OpenAI-compatible vision (проверка практики)
# Можно оставить пустым — тогда ключ возьмётся из .env корня проекта
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:5001
OPENROUTER_APP_TITLE=school-math
AI_MODEL=openai/gpt-5.6-luna-pro
AI_REASONING_EFFORT=high

# Каталог материалов (по умолчанию school_courses_out/ внутри этого проекта)
# SCHOOL_COURSES_DIR=
